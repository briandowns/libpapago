#---------------------------------------------------------------------------
# Project Details
#---------------------------------------------------------------------------
PROJECT_NAME           = "Papago"
PROJECT_NUMBER         = "1.1.0"
OUTPUT_DIRECTORY       = "./docs"
OUTPUT_LANGUAGE        = English
MARKDOWN_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES

#---------------------------------------------------------------------------
# Input Configuration
#---------------------------------------------------------------------------
INPUT                  = ./README.md papago.h
FILE_PATTERNS          = *.c *.h *.md
RECURSIVE              = YES
EXCLUDE                = ./examples ./.github 
USE_MDFILE_AS_MAINPAGE = README.md

#---------------------------------------------------------------------------
# Build & Extraction Options
#---------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

#---------------------------------------------------------------------------
# Website Generation Options (HTML)
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
# Search engine inside the website documentation
SEARCHENGINE           = YES
# Generates a side panel navigation tree
GENERATE_TREEVIEW      = YES

#---------------------------------------------------------------------------
# Man Page Generation Options
#---------------------------------------------------------------------------
GENERATE_MAN           = YES
MAN_OUTPUT             = man
# Defines the section (3 is standard for development library functions)
MAN_EXTENSION          = .3
MAN_SUBDIR             = man3
# Links man pages together when elements reference each other
MAN_LINKS              = YES
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES

#---------------------------------------------------------------------------
# Disable Unnecessary Formats (Speeds up build)
#---------------------------------------------------------------------------
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO
